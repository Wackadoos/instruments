	(text "GY-521, GY-6500,\nGY-9250 or GY-9255\nwill all work.\nGY-925# ispreferred\nfor it's magnometer.\nMost are 3.3v devices\nDo not apply 5v to\nany pins except VCC!"
		(exclude_from_sim no)
		(at 270.51 151.13 0)
		(effects
			(font
				(face "Arial")
				(size 1.27 1.27)
			)
		)
		(uuid "bc2e2adf-811d-4298-9622-7db548b6443a")
	)
	(text "A fixed 5V regulator is preferred as\n5V rail on Arduino bypasses regulators.\nApplying more than 5.5V will destroy it"
